# Rule (27 Oct 2026): no data is deleted or ignored; everything is in git. Files over 50 MB go through Git LFS (see .gitattributes).
# The only exceptions are the two SHoF daily exports below, which are several GB and licensed to SHoF; Alexander holds them and they
# are shared by hand into data/raw/shof/. Everything else that the code reads is in the repo.
.DS_Store
.venv/
__pycache__/
*.pyc
data/raw/shof/Valuations/
data/raw/shof/Reinvestments/
# LaTeX build files
thesis/text/*.aux
thesis/text/*.log
thesis/text/*.out
thesis/text/*.bbl
thesis/text/*.blg
thesis/text/*.synctex.gz
thesis/text/*.toc
thesis/text/*.fls
thesis/text/*.fdb_latexmk
.ipynb_checkpoints/

# Slides build files
slides/build/
